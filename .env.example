# ---- Server-side (set in Vercel → Settings → Environment Variables) ----
# Apps Script web-app URL (ends in /exec). See apps-script/README.md.
RSVP_SCRIPT_URL=
# Must equal the SHARED_SECRET Script Property in Apps Script.
RSVP_SHARED_SECRET=
# Optional; keep in sync with rsvp.maxGuests in src/config/wedding.ts and MAX_GUESTS in Apps Script.
RSVP_MAX_GUESTS=10

# ---- Client-side (optional) ----
# Leave empty to use the same-origin proxy at /api/rsvp (recommended).
VITE_RSVP_API_URL=

# Optional: absolute site URL for link previews, e.g. https://jennifer-asber.vercel.app
# On Vercel this is filled in automatically from the production domain.
SITE_URL=
